<div class="table-container">
  <table class="table is-fullwidth is-hoverable is-striped">
    <thead>
      <tr>
        <th><abbr title="Net">Net</abbr></th>
        <th><abbr title="Income">Income</abbr></th>
        <th><abbr title="Spending">Spending</abbr></th>
        <th><abbr title="Month">Month</abbr></th>
      </tr>
    </thead>
    <tbody>
      <%- income_spend_net.each do |obj| %>
      <tr>
        <td>
          <p class="<%= (obj[:net]).positive? ? 'has-text-success' : 'has-text-danger' %>">
            <%= Money.from_cents(obj[:net] * 100).format %>
          </p>
        </td>
        <td>
          <%= Money.from_cents(obj[:income] * 100).format %>
        </td>
        <td>
          <%= Money.from_cents(obj[:spend] * 100).format %>
        </td>
        <td>
          <%= obj[:month] %>
        </td>
      </tr>
      <%- end %>
      <tr>
        <td>
          <strong>
            Avg Net&colon;
          </strong>
          <% avg_net = income_spend_net.sum{|h| h[:net]} / income_spend_net.length %>
          <p class="<%= avg_net.positive? ? 'has-text-success' : 'has-text-danger' %>">
            <%= Money.from_cents(avg_net * 100).format %>
          </p>
        </td>
        <td>
          <strong>
            Avg Income&colon;
          </strong>
          <p>
            <%= Money.from_cents(income_spend_net.sum{|h| h[:income]} / income_spend_net.length * 100).format %>
          </p>
        </td>
        <td>
          <strong>
            Avg Spend&colon;
          </strong>
          <p>
            <%= Money.from_cents(income_spend_net.sum{|h| h[:spend]} / income_spend_net.length * 100).format %>
          </p>
        </td>
        <td>
          <p>
            &mdash;
          </p>
        </td>
      </tr>
      <tr>
        <td>
          <strong>
            Sum Net&colon;
          </strong>
          <% sum_net = income_spend_net.sum{|h| h[:net]} %>
          <p>
            <%= Money.from_cents(sum_net * 100).format %>
          </p>
        </td>
        <td>
          <strong>
            Sum Income&colon;
          </strong>
          <% sum_income = income_spend_net.sum{|h| h[:income]} %>
          <p>
            <%= Money.from_cents(sum_income * 100).format %>
          </p>
        </td>
        <td>
          <strong>
            Sum Spending&colon;
          </strong>
          <% sum_spending = income_spend_net.sum{|h| h[:spend]} %>
          <p>
            <%= Money.from_cents(sum_spending * 100).format %>
          </p>
        </td>
        <td>
          <p>
            &mdash;
          </p>
        </td>
      </tr>
    </tbody>
    <tfoot>
      <tr>
        <th><abbr title="Net">Net</abbr></th>
        <th><abbr title="Income">Income</abbr></th>
        <th><abbr title="Spending">Spending</abbr></th>
        <th><abbr title="Month">Month</abbr></th>
      </tr>
    </tfoot>
  </table>
</div>
