<%= render partial: 'shared/header', locals: { title: 'Transaction', subtitle: 'All the transactions' } %>
<%= render partial: 'shared/date_filter', locals: {startdate: @startdate, enddate: @enddate} %>

<section class="section">
  <h1 class="title">
    Listing
  </h1>
  <h2 class="subtitle">
    All transactions
  </h2>

  <div class="table-container">
    <table class="table is-fullwidth is-hoverable is-striped transactions-table">
      <% header_cells = capture do %>
        <th><abbr title="ID">ID</abbr></th>
        <th>
          <abbr title="Transaction Date">
            <span class="col-label-full">Transaction Date</span><span class="col-label-short">Date</span>
          </abbr>
        </th>
        <th class="is-hidden-mobile-table"><abbr title="Cleared Date">Cleared Date</abbr></th>
        <th class="transactions-table-description">
          <abbr title="Description">
            <span class="col-label-full">Description</span><span class="col-label-short">Desc</span>
          </abbr>
        </th>
        <th class="is-hidden-mobile-table"><abbr title="Merchant">Merchant</abbr></th>
        <th class="transactions-table-category">
          <abbr title="Category">
            <span class="col-label-full">Category</span><span class="col-label-short">Cat</span>
          </abbr>
        </th>
        <th class="is-hidden-mobile-table"><abbr title="Type">Type</abbr></th>
        <th>
          <abbr title="Amount">
            <span class="col-label-full">Amount</span><span class="col-label-short">Amt</span>
          </abbr>
        </th>
        <th class="is-hidden-mobile-table"><abbr title="Purchased By">Purchased By</abbr></th>
        <th class="is-hidden-mobile-table"><abbr title="Account">Account</abbr></th>
      <% end %>
      <thead>
        <tr><%= header_cells %></tr>
      </thead>
      <tfoot>
        <tr><%= header_cells %></tr>
      </tfoot>
      <tbody>
        <%- @transactions.each do |transaction| %>
        <tr>
          <th><%= link_to transaction.id, transaction_path(transaction) %></th>
          <td>
            <%= transaction.transaction_date %>
          </td>
          <td class="is-hidden-mobile-table">
            <%= transaction.clearing_date %>
          </td>
          <td class="transactions-table-description">
            <%= transaction.description %>
          </td>
          <td class="is-hidden-mobile-table">
            <%= transaction.merchant %>
          </td>
          <td class="transactions-table-category">
            <%= Transaction.pretty_print_category(transaction.category) %>
          </td>
          <td class="is-hidden-mobile-table">
            <%= Transaction.pretty_print_type(transaction.transaction_type) %>
          </td>
          <td>
            <%= Money.from_cents(transaction.amount).format %>
          </td>
          <td class="is-hidden-mobile-table">
            <%= transaction.purchased_by %>
          </td>
          <td class="is-hidden-mobile-table">
            <%= link_to transaction.account.name, bank_path(transaction) %>
          </td>
        </tr>
        <%- end %>
      </tbody>
    </table>
  </div>
  <%== @pagy.series_nav(:bulma) if @pagy.pages > 1 %>
</section>

