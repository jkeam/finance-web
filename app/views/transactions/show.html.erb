<%= render partial: 'shared/header', locals: { title: 'Transaction Detail', subtitle: '' } %>

<section class="section">
  <h1 class="title">
    Transaction: <%= @transaction.id %>
  </h1>
  <h2 class="subtitle">
    <%= Money.from_cents(@transaction.amount_cents).format %>
    to 
    <%= @transaction.merchant %>
    on
    <%= @transaction.transaction_date %>
  </h2>

  <dl class="detail-list">
    <dt>Account</dt>
    <dd><%= link_to @transaction.account.name, transaction_path(@transaction) %></dd>

    <dt>Bank</dt>
    <dd><%= link_to @transaction.account.bank.name, bank_path(@transaction.account.bank) %></dd>

    <dt>Transaction Date</dt>
    <dd><%= @transaction.transaction_date %></dd>

    <dt>Cleared Date</dt>
    <dd><%= @transaction.clearing_date %></dd>

    <dt>Amount</dt>
    <dd><%= Money.from_cents(@transaction.amount_cents).format %></dd>

    <dt>Merchant</dt>
    <dd><%= @transaction.merchant %></dd>

    <dt>Description</dt>
    <dd><%= @transaction.description %></dd>

    <dt>Category</dt>
    <dd><%= Transaction.pretty_print_category(@transaction.category) %></dd>

    <dt>Type</dt>
    <dd><%= Transaction.pretty_print_type(@transaction.transaction_type) %></dd>

    <dt>Purchased By</dt>
    <dd><%= @transaction.purchased_by %></dd>

    <dt>Positive</dt>
    <dd><%= @transaction.positive %></dd>

    <dt>Notes</dt>
    <dd><%= @transaction.notes %></dd>
  </dl>
</section>

<%= link_to 'All Transactions', transactions_path %>
