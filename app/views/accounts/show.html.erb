<%= render partial: 'shared/header', locals: { title: 'Account Detail', subtitle: '' } %>

<section class="section">
  <h1 class="title">
    <%= @account.name %>
  </h1>
  <h2 class="subtitle">
    ID <%= @account.id %>
  </h2>

  <dl class="detail-list">
    <dt>Category</dt>
    <dd><%= @account.category.to_s.titleize %></dd>

    <dt>Bank</dt>
    <dd><%= link_to @account.bank.name, @account.bank %></dd>
  </dl>
</section>

<%= link_to 'All Accounts', accounts_path %>
